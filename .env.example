# Copy to .env.local and fill in (.env.local is gitignored).
# Only the two VITE_ values reach the website; they are public by design (RLS protects the data).
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Local scripts only (scripts/, e2e/). Secret: never in frontend code, never in Netlify.
SUPABASE_SERVICE_ROLE_KEY=
# Database access for npm run db:migrate: either the password (the script finds the pooler host)…
SUPABASE_DB_PASSWORD=
# …or a full connection string (Supabase dashboard → Connect → Session pooler). Takes precedence.
SUPABASE_DB_URL=

# Optional: public site address used in sitemap.xml / robots.txt (Netlify sets URL automatically)
SITE_URL=
