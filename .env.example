# انسخ هذا الملف إلى .env.local وعبّئ القيم (.env.local لا يُرفع على git).
# السطران الأولان فقط يدخلان الموقع (عامّان بطبيعتهما؛ الحماية بـ RLS).
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# للسكربتات المحلية فقط (scripts/) — سرّية، ممنوع تدخل كود الواجهة أو Netlify
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
